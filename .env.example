# Port the server listens on (Railway sets PORT automatically)
PORT=3000

# Shared secret Vapi sends in the x-vapi-secret header on every tool call.
# Set the same value in the Vapi dashboard under the assistant's server settings.
# If unset, secret verification is skipped (local dev only — always set in production).
VAPI_WEBHOOK_SECRET=

# pino log level: debug | info | warn | error
LOG_LEVEL=info
